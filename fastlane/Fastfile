default_platform(:ios)

platform :ios do
  desc "Sign with an App Store Connect API key (no match) and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    get_certificates(api_key: api_key, development: false)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.tongshan.hokkaidoski"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]
    team_id = ENV["ASC_TEAM_ID"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: "com.tongshan.hokkaidoski"
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.tongshan.hokkaidoski" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
